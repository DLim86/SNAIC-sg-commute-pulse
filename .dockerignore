# ── Secrets: must never enter the build context or an image layer ────────────
config.py
credentials.json
token*.json
Google Calendar/
.env
*.pem
*.key

# ── Local credential/registration documents ──────────────────────────────────
LTA/
OneMap/
Prompt.txt

# ── Course material / local artifacts ────────────────────────────────────────
project_instructions.pdf
*.pdf
AGENTS.md
CLAUDE.md
bus_service.py
nearest_busstop.py

# ── Databases: `*.duckdb` alone does not match db/commute.duckdb, because
#    Docker ignore patterns do not cross a path separator. Use **/ as well.
*.duckdb
*.duckdb.wal
**/*.duckdb
**/*.duckdb.wal
db/

# ── Build artifacts and local environments ───────────────────────────────────
.venv/
venv/
env/
.git/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# ── Raw landing zone: regenerated on every run, never needed in the image ──────
data/raw/

# ── Model binaries (regenerated by scripts/model.py --train) ─────────────────
models/*.pkl

# ── Misc ─────────────────────────────────────────────────────────────────────
*.log
docs/
.vscode/
.idea/
